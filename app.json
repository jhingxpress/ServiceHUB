{
  "expo": {
    "name": "ServiceHub",
    "slug": "servicehub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "com.servicehub.app",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#B91C1C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.servicehub.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B91C1C"
      },
      "package": "com.servicehub.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ServiceHub to access your photos.",
          "cameraPermission": "Allow ServiceHub to use your camera."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ServiceHub to use your location.",
          "locationWhenInUsePermission": "Allow ServiceHub to use your location while using the app."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B91C1C",
          "iosDisplayInForeground": true,
          "androidMode": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8fcfed4e-bbe6-4787-a1c1-88ae62fbf65d"
      }
    }
  }
}
