# TAGA Beta Reset — Environment Variables
# Copy this file to .env.beta-reset and fill in the values.
# Do NOT commit .env.beta-reset to version control.

# Supabase project URL (required)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (required)
# Found in: Supabase Dashboard → Settings → API → service_role key
# WARNING: This key bypasses RLS. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin email to preserve (default: jhingxpress@gmail.com)
ADMIN_EMAIL=jhingxpress@gmail.com

# PostgreSQL connection string for pg_dump backup (optional but recommended)
# Found in: Supabase Dashboard → Settings → Database → Connection string
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_DB_URL=
